# Mode « api » : le front appelle le back-end (simulé en local par backend/, FastAPI).
# Utilisé par : npm run dev:api  /  npm run build:api  (vite --mode api)
VITE_BACKEND=api
# Vide en local : les appels /api passent par le proxy Vite vers http://127.0.0.1:3001
VITE_API_URL=
# Aides de test dans l'interface (règles de simulation des paiements)
VITE_TEST_HINTS=1
