# Variables d'environnement Ô musiki (Vite) — copier en .env.local et renseigner.
# Seules les variables préfixées VITE_ sont exposées au navigateur : n'y mettre AUCUN secret.

# Back-end : demo (tout simulé dans le navigateur) | api (back-end local simulé, puis services réels)
VITE_BACKEND=demo
# URL de l'API. Vide en local : les appels /api passent par le proxy Vite (vite.config.mjs) vers 127.0.0.1:3001
VITE_API_URL=
# Aides de test affichées dans l'interface (0 pour les masquer)
VITE_TEST_HINTS=1

# Identité (Amazon Cognito) — les fournisseurs Google et Apple se configurent dans Cognito
VITE_COGNITO_REGION=eu-west-3
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=

# Streaming (Mux Data — clé d'environnement publique)
VITE_MUX_ENV_KEY=

# Paiement carte (clé publique Stripe)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# Analytique (Mixpanel)
VITE_MIXPANEL_TOKEN=
